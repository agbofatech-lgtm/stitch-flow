NODE_ENV=development
PORT=5000
MOUNT_UNAUTHENTICATED_BUSINESS_ROUTES=false

# Optional. If unset, platform IAM uses in-memory store (TRANSITIONAL).
# If set, file JSON persistence is used. Postgres is NOT VERIFIED.
PLATFORM_DATA_PATH=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stitchflow
JWT_SECRET=replace_me
REFRESH_TOKEN_SECRET=replace_me_too
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173
MAX_PAYLOAD_SIZE=1mb

BCRYPT_ROUNDS=12

ADMIN_EMAIL=admin@stitchflow.app
ADMIN_PASSWORD=ChangeMe123!

FREE_DEVICE_LIMIT=1
PRO_DEVICE_LIMIT=2
ENTERPRISE_DEVICE_LIMIT=5

REDIS_URL=redis://redis:6379

RENDER_EXTERNAL_URL=http://localhost:3000

# Provider-neutral billing webhook HMAC (not a live PSP).
BILLING_WEBHOOK_SECRET=replace_me_webhook

# Vite (apps/web). Copy into apps/web/.env.local if needed.
VITE_API_BASE_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000
