{
  "name": "stitch-flow",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:backend": "npm --workspace=apps/backend run dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "build": "npm run build --workspaces",
    "start": "npm --workspace=apps/backend run start",
    "test:backend": "npm --workspace=apps/backend test"
  },
  "dependencies": {
    "@bull-board/api": "^6.20.5",
    "@bull-board/express": "^6.20.5",
    "cors": "^2.8.6"
  },
  "version": "1.0.0",
  "description": "Production-ready Express + TypeScript + PostgreSQL backend for StitchFlow.",
  "main": "apps/backend/dist/server.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.0.0"
  }
}
