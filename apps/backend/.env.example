NODE_ENV=development
PORT=5000
MOUNT_UNAUTHENTICATED_BUSINESS_ROUTES=false

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/stitchflow
SHOP_DATABASE_MODE=memory
# SHOP_DATABASE_MODE=postgres
# SHOP_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/stitchflow
JWT_SECRET=replace_me
BILLING_WEBHOOK_SECRET=replace_me_billing_webhook
PLATFORM_DATA_PATH=data/platform-store.json
REFRESH_TOKEN_SECRET=replace_me_too
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173
MAX_PAYLOAD_SIZE=1mb

BCRYPT_ROUNDS=12

ADMIN_EMAIL=admin@stitchflow.app
ADMIN_PASSWORD=ChangeMe123!

FREE_DEVICE_LIMIT=1
PRO_DEVICE_LIMIT=2
ENTERPRISE_DEVICE_LIMIT=5

REDIS_URL=redis://redis:6379

RENDER_EXTERNAL_URL=http://localhost:3000

