NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/stitchflow
JWT_SECRET=replace_me
REFRESH_TOKEN_SECRET=replace_me_too
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173
MAX_PAYLOAD_SIZE=1mb

BCRYPT_ROUNDS=12

# --- Phase 9: commercial identity & account recovery (SERVER-ONLY) ---
# Email delivery transport: 'console' (dev/test — logs the delivery payload;
# refuses in production) | 'smtp' (integration is a documented external
# dependency of a later phase; selecting it today fails safe, no delivery).
EMAIL_TRANSPORT=console
# Public web origin used to build password-reset links.
AUTH_PUBLIC_BASE_URL=http://localhost:5173
# Password-reset token lifetime in minutes (tokens are single-use regardless).
PASSWORD_RESET_TTL_MINUTES=15

ADMIN_EMAIL=admin@stitchflow.app
ADMIN_PASSWORD=ChangeMe123!

FREE_DEVICE_LIMIT=1
PRO_DEVICE_LIMIT=2
ENTERPRISE_DEVICE_LIMIT=5

REDIS_URL=redis://redis:6379

RENDER_EXTERNAL_URL=http://localhost:3000


# --- Phase 5: commercial configuration (SERVER-ONLY) ---
# Trial length (days) and plan granted to new-workspace trials.
TRIAL_DAYS=14
TRIAL_PLAN_CODE=STUDIO
# Billing provider: 'paystack' or 'none'. Tests always use the built-in test provider.
BILLING_PROVIDER=none
# Paystack secret key — SERVER-ONLY. NEVER prefix with VITE_. NEVER commit a real key.
PAYSTACK_SECRET_KEY=

# --- Phase 8: webhooks ------------------------------------------------------
# AES key for webhook signing-secret envelopes (falls back to JWT_SECRET)
WEBHOOK_ENCRYPTION_KEY=
# Webhook delivery timeout in milliseconds
WEBHOOK_DELIVERY_TIMEOUT_MS=10000
# Allow private/loopback webhook destinations (local testing ONLY)
WEBHOOK_ALLOW_PRIVATE_DESTINATIONS=false

# --- Phase 17: AI Tailoring Intelligence (SERVER-ONLY, optional) -----------
# StitchFlow is fully functional with AI absent. Leave unset to disable.
# Never prefix these with VITE_ — they must never reach the browser bundle.
AI_ENABLED=false
# none | deterministic | openai | gemini | claude
AI_PROVIDER=none
AI_RATE_LIMIT_PER_MINUTE=20
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
